   "source": [
    "# XAI Sensitivity & Stability — CPU vs GPU(L4) 비교\n",
    "\n",
    "**런타임: L4 GPU** (런타임 → 런타임 유형 변경 → L4)\n",
    "\n",
    "셀 순서대로 실행. 셀3에서 데이터zip + 가중치zip 업로드."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1) 클론 + 패키지\n",
    "%cd /content\n",
    "!rm -rf fireimage_detection\n",
    "!git clone https://github.com/yuntaewon812/fireimage_detection.git fireimage_detection -q\n",
    "!pip install timm einops pytorch-grad-cam lime shap -q\n",
    "import torch\n",
    "print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU only')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2) 데이터 + 가중치 업로드\n",
    "# fireimage_clean.zip  →  data/fireimage/ 생성\n",
    "# weights_E.zip        →  model_save/fireimage_abl_E/ 생성\n",
    "from google.colab import files\n",
    "uploaded = files.upload()   # 두 파일 모두 선택"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3) 압축 해제\n",
    "import zipfile, os\n",
    "BASE = '/content/fireimage_detection'\n",
    "\n",
    "if os.path.exists('/content/fireimage_clean.zip'):\n",
    "    !python {BASE}/colab_setup.py\n",
    "    print('데이터 압축 해제 완료')\n",
    "\n",
    "if os.path.exists('/content/weights_E.zip'):\n",
    "    with zipfile.ZipFile('/content/weights_E.zip', 'r') as z:\n",
    "        z.extractall(BASE)\n",
    "    print('가중치 압축 해제 완료')\n",
    "\n",
    "# 가중치 확인\n",
    "w_dir = f'{BASE}/model_save/fireimage_abl_E/fold0'\n",
    "print('fold0 가중치:', os.listdir(w_dir) if os.path.exists(w_dir) else '없음')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4) Sensitivity & Stability 실행 (GPU)\n",
    "%cd /content/fireimage_detection\n",
    "import time\n",
    "t0 = time.time()\n",
    "!python sensitivity_stability.py\n",
    "gpu_total = time.time() - t0\n",
    "print(f'\\n총 GPU 실행 시간: {gpu_total:.1f}s ({gpu_total/60:.1f}분)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5) CPU 시뮬레이션 결과와 비교\n",
    "# (로컬에서 실행한 sens_stab_cpu.csv 업로드 후 비교)\n",
    "import pandas as pd\n",
    "\n",
    "gpu_df = pd.read_csv('results_SENS_STAB/sens_stab_cuda.csv')\n",
    "\n",
    "print('=== GPU (L4) 결과 ===')\n",
    "print(gpu_df[['Model','Method','Sensitivity','Stability','Time_sec']].to_string(index=False))\n",
    "\n",
    "# CPU 결과 파일이 있으면 같이 비교\n",
    "cpu_path = 'results_SENS_STAB/sens_stab_cpu.csv'\n",
    "if os.path.exists(cpu_path):\n",
    "    cpu_df = pd.read_csv(cpu_path)\n",
    "    compare = gpu_df[['Model','Method','Time_sec']].rename(columns={'Time_sec':'GPU_sec'})\n",
    "    compare['CPU_sec'] = cpu_df['Time_sec'].values\n",
    "    compare['Speedup'] = (compare['CPU_sec'] / compare['GPU_sec']).round(1)\n",
    "    print('\\n=== CPU vs GPU 속도 비교 ===')\n",
    "    print(compare.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6) 결과 다운로드\n",
    "from google.colab import files\n",
    "files.download('results_SENS_STAB/sens_stab_cuda.csv')"
   ]
  }
 ]
}"
